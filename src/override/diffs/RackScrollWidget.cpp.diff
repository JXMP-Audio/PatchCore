+/** The knob under the mouse, if any (the hovered widget or one of its parents) */
+static Knob* hoveredKnob() {
+	for (widget::Widget* w = APP->event->hoveredWidget; w; w = w->parent) {
+		if (Knob* const k = dynamic_cast<Knob*>(w))
+			return k;
+	}
+	return nullptr;
+}
